# Copy to .env and fill in. `.env` is gitignored; nothing in this file is a real
# secret and nothing here should become one — every value below is either a
# local-only default or a placeholder.

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
NODE_ENV=development

# Admin panel path. Worth changing to something non-obvious in a deployed env.
ADMIN_PATH=/admin

# ─── Database ────────────────────────────────────────────────────────────────
# Matches docker/docker-compose.yml. Port 5434, not 5432 — see that file.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_NAME=wgb_strapi
DATABASE_USERNAME=wgb
DATABASE_PASSWORD=wgb
DATABASE_SCHEMA=public
DATABASE_SSL=false

# ─── Storefront ──────────────────────────────────────────────────────────────
# The one WeddingGiftBox origin. Used for CORS, the CSP frame-ancestors list and
# the Preview button's target. `wedding-gift-box` runs on 3001 locally.
NEXTJS_WGB_ORIGIN=http://localhost:3001

# ─── Preview ─────────────────────────────────────────────────────────────────
# MUST match BLOG_PREVIEW_SECRET on wgb-backend and PREVIEW_SECRET on
# wedding-gift-box. There is no default: leave it unset and the Preview button
# is hidden and says so in the log, rather than linking somewhere that bounces
# the editor to the homepage. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PREVIEW_SECRET=

# ─── S3 upload (optional locally) ────────────────────────────────────────────
# Leave AWS_BUCKET empty to store uploads on local disk under public/uploads —
# which is what a local run wants, and which wedding-gift-box's next.config.ts
# already allows through next/image.
#
# These are the same names config/plugins.js reads and config/middlewares.js
# builds the CSP from. Do not introduce a second spelling.
AWS_REGION=ap-south-1
AWS_BUCKET=
AWS_CDN_URL=
AWS_UPLOAD_PATH=

# ─── Strapi secrets ──────────────────────────────────────────────────────────
# Generate fresh values. Deployed environments read these from Secrets Manager.
#   node -e "console.log(Array.from({length:4},()=>require('crypto').randomBytes(16).toString('base64')).join(','))"
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
