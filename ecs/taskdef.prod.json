{
  "family": "prod-wgb-strapi",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/prod-wgb-strapi-ecs-exec-role",
  "taskRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/prod-wgb-strapi-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "log_router",
      "image": "${ACCOUNT_ID}.dkr.ecr.ap-south-1.amazonaws.com/prod-fluent-bit:3.2.2",
      "cpu": 0,
      "memoryReservation": 50,
      "portMappings": [],
      "essential": true,
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [],
      "user": "0",
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/prod-wgb-strapi",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "firelens"
        }
      },
      "systemControls": [],
      "firelensConfiguration": {
        "type": "fluentbit",
        "options": {
          "enable-ecs-log-metadata": "true"
        }
      }
    },
    {
      "name": "wgb-strapi",
      "image": "REPLACED_AT_DEPLOY",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 1337,
          "hostPort": 1337,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "PORT",
          "value": "1337"
        },
        {
          "name": "ADMIN_PATH",
          "value": "/admin"
        },
        {
          "name": "STRAPI_TELEMETRY_DISABLED",
          "value": "true"
        },
        {
          "name": "STRAPI_DISABLE_UPDATE_NOTIFICATION",
          "value": "true"
        },
        {
          "name": "PUBLIC_URL",
          "value": "https://blogs.weddinggiftbox.com"
        },
        {
          "name": "NEXTJS_WGB_ORIGIN",
          "value": "https://www.weddinggiftbox.com"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-south-1"
        },
        {
          "name": "AWS_BUCKET",
          "value": "img-weddingbazaar-com"
        },
        {
          "name": "AWS_CDN_URL",
          "value": "https://img.weddingbazaar.com"
        },
        {
          "name": "AWS_UPLOAD_PATH",
          "value": "wgb-strapi/uploads/"
        },
        {
          "name": "OTEL_EXPORTER_OTLP_ENDPOINT",
          "value": "http://localhost:4317"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DATABASE_HOST",
          "valueFrom": "${SECRET_ARN}:DATABASE_HOST::"
        },
        {
          "name": "DATABASE_PORT",
          "valueFrom": "${SECRET_ARN}:DATABASE_PORT::"
        },
        {
          "name": "DATABASE_NAME",
          "valueFrom": "${SECRET_ARN}:DATABASE_NAME::"
        },
        {
          "name": "DATABASE_USERNAME",
          "valueFrom": "${SECRET_ARN}:DATABASE_USERNAME::"
        },
        {
          "name": "DATABASE_PASSWORD",
          "valueFrom": "${SECRET_ARN}:DATABASE_PASSWORD::"
        },
        {
          "name": "DATABASE_SCHEMA",
          "valueFrom": "${SECRET_ARN}:DATABASE_SCHEMA::"
        },
        {
          "name": "APP_KEYS",
          "valueFrom": "${SECRET_ARN}:APP_KEYS::"
        },
        {
          "name": "API_TOKEN_SALT",
          "valueFrom": "${SECRET_ARN}:API_TOKEN_SALT::"
        },
        {
          "name": "ADMIN_JWT_SECRET",
          "valueFrom": "${SECRET_ARN}:ADMIN_JWT_SECRET::"
        },
        {
          "name": "TRANSFER_TOKEN_SALT",
          "valueFrom": "${SECRET_ARN}:TRANSFER_TOKEN_SALT::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "${SECRET_ARN}:JWT_SECRET::"
        },
        {
          "name": "PREVIEW_SECRET",
          "valueFrom": "${SECRET_ARN}:PREVIEW_SECRET::"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "valueFrom": "${SECRET_ARN}:AWS_ACCESS_KEY_ID::"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "valueFrom": "${SECRET_ARN}:AWS_SECRET_ACCESS_KEY::"
        }
      ],
      "dependsOn": [
        {
          "containerName": "log_router",
          "condition": "START"
        },
        {
          "containerName": "otel-collector",
          "condition": "START"
        }
      ],
      "logConfiguration": {
        "logDriver": "awsfirelens",
        "options": {
          "Host": "loki.prod-observability.internal",
          "line_format": "json",
          "Name": "loki",
          "Port": "3100",
          "labels": "job=wgb-strapi, product=weddinggiftbox, environment=prod, service=wgb-strapi"
        }
      },
      "systemControls": []
    },
    {
      "name": "otel-collector",
      "image": "${ACCOUNT_ID}.dkr.ecr.ap-south-1.amazonaws.com/prod-otel-collector:adot-0.40.0",
      "cpu": 64,
      "memoryReservation": 128,
      "portMappings": [
        {
          "containerPort": 4317,
          "hostPort": 4317,
          "protocol": "tcp"
        },
        {
          "containerPort": 4318,
          "hostPort": 4318,
          "protocol": "tcp"
        },
        {
          "containerPort": 13133,
          "hostPort": 13133,
          "protocol": "tcp"
        }
      ],
      "essential": false,
      "command": [
        "--config=env:AOT_CONFIG_CONTENT"
      ],
      "environment": [
        {
          "name": "AOT_CONFIG_CONTENT",
          "value": "\"exporters\":\n  \"otlp\":\n    \"endpoint\": \"tempo.prod-observability.internal:4317\"\n    \"tls\":\n      \"insecure\": true\n  \"prometheusremotewrite\":\n    \"add_metric_suffixes\": false\n    \"endpoint\": \"http://prometheus.prod-observability.internal:9090/api/v1/write\"\n    \"external_labels\":\n      \"environment\": \"prod\"\n      \"product\": \"weddinggiftbox\"\n      \"service\": \"wgb-strapi\"\n    \"resource_to_telemetry_conversion\":\n      \"enabled\": true\n    \"tls\":\n      \"insecure\": true\n\"extensions\":\n  \"health_check\":\n    \"endpoint\": \"0.0.0.0:13133\"\n\"processors\":\n  \"batch\":\n    \"send_batch_size\": 1000\n    \"timeout\": \"5s\"\n  \"filter\":\n    \"metrics\":\n      \"exclude\":\n        \"match_type\": \"regexp\"\n        \"metric_names\":\n        - \"ecs_network.*\"\n        - \"container\\\\.network.*\"\n      \"include\":\n        \"match_type\": \"regexp\"\n        \"metric_names\":\n        - \"ecs_.*\"\n        - \"container_.*\"\n  \"memory_limiter\":\n    \"check_interval\": \"1s\"\n    \"limit_mib\": 128\n    \"spike_limit_mib\": 32\n  \"metricstransform\":\n    \"transforms\":\n    - \"action\": \"update\"\n      \"include\": \"ecs.task.cpu.utilized\"\n      \"new_name\": \"ecs_cpu_utilized\"\n    - \"action\": \"update\"\n      \"include\": \"ecs.task.cpu.reserved\"\n      \"new_name\": \"ecs_cpu_reserved\"\n    - \"action\": \"update\"\n      \"include\": \"ecs.task.memory.utilized\"\n      \"new_name\": \"ecs_memory_utilized_mb\"\n    - \"action\": \"update\"\n      \"include\": \"ecs.task.memory.reserved\"\n      \"new_name\": \"ecs_memory_reserved_mb\"\n    - \"action\": \"update\"\n      \"include\": \"ecs.task.memory.usage\"\n      \"new_name\": \"ecs_memory_usage_bytes\"\n    - \"action\": \"update\"\n      \"include\": \"container.cpu.utilized\"\n      \"new_name\": \"ecs_container_cpu_utilized\"\n    - \"action\": \"update\"\n      \"include\": \"container.cpu.reserved\"\n      \"new_name\": \"ecs_container_cpu_reserved\"\n    - \"action\": \"update\"\n      \"include\": \"container.memory.utilized\"\n      \"new_name\": \"ecs_container_memory_utilized_mb\"\n    - \"action\": \"update\"\n      \"include\": \"container.memory.reserved\"\n      \"new_name\": \"ecs_container_memory_reserved_mb\"\n    - \"action\": \"update\"\n      \"include\": \"container.memory.usage\"\n      \"new_name\": \"ecs_container_memory_usage_bytes\"\n  \"resource\":\n    \"attributes\":\n    - \"action\": \"upsert\"\n      \"key\": \"product\"\n      \"value\": \"weddinggiftbox\"\n    - \"action\": \"upsert\"\n      \"key\": \"environment\"\n      \"value\": \"prod\"\n    - \"action\": \"upsert\"\n      \"key\": \"service\"\n      \"value\": \"wgb-strapi\"\n\"receivers\":\n  \"awsecscontainermetrics\":\n    \"collection_interval\": \"30s\"\n  \"otlp\":\n    \"protocols\":\n      \"grpc\":\n        \"endpoint\": \"0.0.0.0:4317\"\n      \"http\":\n        \"endpoint\": \"0.0.0.0:4318\"\n\"service\":\n  \"extensions\":\n  - \"health_check\"\n  \"pipelines\":\n    \"metrics\":\n      \"exporters\":\n      - \"prometheusremotewrite\"\n      \"processors\":\n      - \"memory_limiter\"\n      - \"resource\"\n      - \"metricstransform\"\n      - \"filter\"\n      - \"batch\"\n      \"receivers\":\n      - \"otlp\"\n      - \"awsecscontainermetrics\"\n    \"traces\":\n      \"exporters\":\n      - \"otlp\"\n      \"processors\":\n      - \"memory_limiter\"\n      - \"resource\"\n      - \"batch\"\n      \"receivers\":\n      - \"otlp\"\n"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/prod-wgb-strapi",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "otel"
        }
      },
      "systemControls": []
    }
  ]
}
